{
  "name": "stok-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "sanity schema extract --force --path src/sanity/schema.json && sanity typegen generate",
    "seed": "sanity exec scripts/seed-sanity.ts --with-user-token --",
    "seed:content": "sanity exec scripts/seed-content.ts --with-user-token --",
    "remove:products": "sanity exec scripts/remove-sanity-products.ts --with-user-token --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@sanity/client": "^8.17.0",
    "@sanity/document-internationalization": "^6.3.0",
    "@sanity/icons": "^5.4.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.24.0",
    "next": "16.4.6",
    "next-sanity": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.24.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.x"
  }
}
