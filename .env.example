# Sanity. Nettsiden krever prosjekt-ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Lesetoken (Viewer) for kladder i forhåndsvisningen (Draft Mode og Presentation-verktøyet).
# Lages under API → Tokens på sanity.io/manage. Sendes aldri til nettleseren. Se docs/11-forhandsvisning.md.
SANITY_API_READ_TOKEN=

# Hemmelighet for webhooken fra Sanity (app/api/revalidate). Samme verdi som i webhooken på sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Adressen til nettstedet, brukt i canonical, sitemap, Open Graph og JSON-LD.
# Uten den brukes produksjonsdomenet fra Vercel, og lokalt http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Sett til true når siden skal indekseres. Ellers får alle sider noindex og X-Robots-Tag.
SITE_ALLOW_INDEXING=
